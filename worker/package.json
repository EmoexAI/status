{
  "name": "emoex-status-maillist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public email subscription list for status.emoexai.com",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute emoex-status-maillist --remote --file=./schema.sql",
    "db:local": "wrangler d1 execute emoex-status-maillist --local --file=./schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
